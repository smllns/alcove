# Copy to server/.env and fill in. Never commit the real file.

# From MongoDB Atlas: Connect → Drivers → Node.js. Put your database user's
# password in place of <db_password>.
MONGODB_URI=mongodb+srv://alcove-app:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=alcove

# Database name inside the cluster; created automatically on first write
MONGODB_DB=alcove

# Port for the API. Vite proxies /api here in development.
PORT=3001

# Optional: cover photo uploads (Vercel Blob). On Vercel nothing to do here:
# connecting the store sets BLOB_STORE_ID and auth happens on its own.
# Locally, either paste the store id here and run `vercel env pull` (it writes
# a short-lived VERCEL_OIDC_TOKEN to .env.local, which dev also reads), or
# paste a read-write token. Without either, uploads are hidden.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Optional: an email Open Library can reach you at about heavy traffic.
# It goes in the User-Agent and triples their rate limit (1 → 3 a second).
# OPENLIBRARY_CONTACT=
